#!/bin/bash
# Lanzador del icono Mejorador Stems.
# macOS no deja a este icono leer la carpeta Documentos, así que: si el
# servidor ya está en marcha abre el navegador, y si no, pide a Terminal
# (que sí tiene permiso) que ejecute "Iniciar Mejorador Stems.command".
# carpeta de la app = la que contiene este .app (calculada como texto: no necesita leer Documentos)
APP_DIR="${0%/Mejorador Stems.app/*}"

for P in $(seq 8915 8919); do
  if /usr/bin/curl -s -m 1 "http://127.0.0.1:$P/api/config" | /usr/bin/grep -q '"mejorador-stems"'; then
    /usr/bin/open "http://127.0.0.1:$P"
    exit 0
  fi
done

/usr/bin/osascript <<OSA
tell application "Terminal"
    activate
    do script "\"$APP_DIR/Iniciar Mejorador Stems.command\""
end tell
OSA
